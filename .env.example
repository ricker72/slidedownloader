# Variables de entorno para SlideDownloader
# Copia este archivo a .env y edita los valores

# URL del servidor de renderizado externo (Puppeteer)
# Despliega renderer-service/ en Railway, Render o fly.io y pon aquí su URL.
# Ejemplo: https://slide-renderer.railway.app
# Si no lo configuras, /api/inspect usará solo fetch directo (SlideShare puede bloquearlo).
RENDERER_URL=

# Puerto del servidor local
PORT=8080
