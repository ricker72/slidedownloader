{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/download/(.*)", "dest": "/api/index.js" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/ai.js", "dest": "/public/ai.js" },
    { "src": "/ai", "dest": "/public/ai.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
